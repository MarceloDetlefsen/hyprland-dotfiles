{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 1,
            "left": 1
        },
        "height": 16,
        "width": 28
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "#89b4fa"
        }
    },
    "modules": [
        {
            "type": "title",
            "keyWidth": 8,
            "color": {
                "user": "#a6e3a1",
                "at": "#f38ba8",
                "host": "#89b4fa"
            }
        },
        {
            "type": "custom",
            "format": "  {##6c7086}┄ {##89b4fa}┄ {##a6e3a1}┄ {##f9e2af}┄ {##fab387}┄ {##94e2d5}┄ {##cba6f7}┄"
        },
        {
            "type": "os",
            "key": "󰍹 OS",
            "keyColor": "#f9e2af"
        },
        {
            "type": "kernel",
            "key": "󰌽 Kernel",
            "keyColor": "#f9e2af"
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "#f9e2af"
        },
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "#89b4fa"
        },
        {
            "type": "lm",
            "key": "󰧨 Login",
            "keyColor": "#89b4fa"
        },
        {
            "type": "wmtheme",
            "key": "󰸉 Theme",
            "keyColor": "#89b4fa"
        },
        {
            "type": "terminal",
            "key": " Terminal",
            "keyColor": "#89b4fa"
        },
        {
            "type": "host",
            "key": "󰌢 PC",
            "keyColor": "#a6e3a1"
        },
        {
            "type": "Disk",
            "key": "󰋊 Storage",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage})",
            "keyColor": "#a6e3a1"
        },
        {
            "type": "memory",
            "key": " Memory",
            "keyColor": "#a6e3a1"
        },
        {
            "type": "swap",
            "key": "󰓡 Swap",
            "keyColor": "#a6e3a1"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "keyColor": "#a6e3a1"
        },
        {
            "type": "display",
            "key": "󰍹 Display",
            "keyColor": "#a6e3a1"
        },
        {
            "type": "sound",
            "key": " SND",
            "keyColor": "#94e2d5"
        },
        "break",
        {
            "type": "custom",
            "format": "  {##6c7086}┄ {##89b4fa}┄ {##a6e3a1}┄ {##f9e2af}┄ {##fab387}┄ {##94e2d5}┄ {##cba6f7}┄"
        }
    ]
}
