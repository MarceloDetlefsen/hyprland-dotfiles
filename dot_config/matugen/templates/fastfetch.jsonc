{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "padding": {
            "top": 1,
            "left": 1
        },
        "height": 16,
        "width": 28
    },
    "display": {
        "separator": "  ",
        "color": {
            "keys": "{{ colors.primary.default.hex }}"
        }
    },
    "modules": [
        {
            "type": "title",
            "keyWidth": 8,
            "color": {
                "user": "{{ colors.primary.default.hex }}",
                "at": "{{ colors.error.default.hex }}",
                "host": "{{ colors.secondary.default.hex }}"
            }
        },
        {
            "type": "custom",
            "format": "  {##{{ colors.on_surface_variant.default.hex_stripped }}}┄ {##{{ colors.primary.default.hex_stripped }}}┄ {##{{ colors.secondary.default.hex_stripped }}}┄ {##{{ colors.tertiary.default.hex_stripped }}}┄ {##{{ colors.error.default.hex_stripped }}}┄"
        },
        {
            "type": "os",
            "key": "󰍹 OS",
            "keyColor": "{{ colors.primary.default.hex }}"
        },
        {
            "type": "kernel",
            "key": "󰌽 Kernel",
            "keyColor": "{{ colors.primary.default.hex }}"
        },
        {
            "type": "shell",
            "key": " Shell",
            "keyColor": "{{ colors.primary.default.hex }}"
        },
        {
            "type": "wm",
            "key": " WM",
            "keyColor": "{{ colors.secondary.default.hex }}"
        },
        {
            "type": "lm",
            "key": "󰧨 Login",
            "keyColor": "{{ colors.secondary.default.hex }}"
        },
        {
            "type": "wmtheme",
            "key": "󰸉 Theme",
            "keyColor": "{{ colors.secondary.default.hex }}"
        },
        {
            "type": "terminal",
            "key": " Terminal",
            "keyColor": "{{ colors.secondary.default.hex }}"
        },
        {
            "type": "host",
            "key": "󰌢 PC",
            "keyColor": "{{ colors.tertiary.default.hex }}"
        },
        {
            "type": "Disk",
            "key": "󰋊 Storage",
            "folders": "/",
            "format": "{size-used} / {size-total} ({size-percentage})",
            "keyColor": "{{ colors.tertiary.default.hex }}"
        },
        {
            "type": "memory",
            "key": " Memory",
            "keyColor": "{{ colors.tertiary.default.hex }}"
        },
        {
            "type": "swap",
            "key": "󰓡 Swap",
            "keyColor": "{{ colors.tertiary.default.hex }}"
        },
        {
            "type": "uptime",
            "key": "󰅐 Uptime",
            "keyColor": "{{ colors.tertiary.default.hex }}"
        },
        {
            "type": "display",
            "key": "󰍹 Display",
            "keyColor": "{{ colors.tertiary.default.hex }}"
        },
        {
            "type": "sound",
            "key": " SND",
            "keyColor": "{{ colors.tertiary.default.hex }}"
        },
        "break",
        {
            "type": "custom",
            "format": "  {##{{ colors.on_surface_variant.default.hex_stripped }}}┄ {##{{ colors.primary.default.hex_stripped }}}┄ {##{{ colors.secondary.default.hex_stripped }}}┄ {##{{ colors.tertiary.default.hex_stripped }}}┄ {##{{ colors.error.default.hex_stripped }}}┄"
        }
    ]
}
